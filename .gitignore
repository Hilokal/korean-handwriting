# Python
venv/
.venv/
__pycache__/
*.pyc

# Model checkpoints — large binaries; the bundled models are force-added.
# best_model.pressure.pt is the current bundled model; best_model.emb8.pt is
# the pre-pressure one, kept as a historical artifact (no longer loads).
*.pt
!handwriting-generation/best_model.emb8.pt
!handwriting-generation/best_model.pressure.pt
checkpoint.pt

# Data — recordings and the production export are not committed (see download_export.sh).
data/
*.db
*.db-shm
*.db-wal

# Training / run artifacts
*.log
generated.json
*.svg

# Node
node_modules/
dist/
build/

# Secrets / env
.env
.env.*

# OS / editor
.DS_Store
.vscode/

# Local Claude Code settings
.claude/settings.local.json

# demo-app generated artifacts (public/model IS committed; ort wasm is copied
# from node_modules at build time)
demo-app/public/ort/
demo-app/scripts/smoke-output.svg
